<?xml version="1.0" encoding="utf-8"?>
<!--
  Allows cleartext HTTP to our server while HTTPS is not yet set up.
  Remove base-config and keep only domain-config once the server has TLS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
