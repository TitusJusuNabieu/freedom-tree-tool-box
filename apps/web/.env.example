# Copy to .env.local and fill in real values:
#   cp .env.example .env.local
#
# Used by the Next.js dev/build process. Must match the root .env's
# DATABASE_URL.

# Same PostgreSQL connection string as the root .env
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/freedomtree_dev"

# HS256 secret for signing JWT access tokens (mobile API)
# Generate with:  openssl rand -base64 32
JWT_ACCESS_SECRET="REPLACE_WITH_RANDOM_SECRET"

# NextAuth session secret (dashboard login)
# Generate with:  openssl rand -base64 32
NEXTAUTH_SECRET="REPLACE_WITH_ANOTHER_RANDOM_SECRET"

# Local dev URL — leave as-is unless you changed the dev port
NEXTAUTH_URL="http://localhost:3000"
