# Copy to .env and fill in real values:
#   cp .env.example .env
#
# Used by Prisma CLI commands run from the repo root (prisma:generate,
# prisma:migrate, prisma:seed). Must match apps/web/.env.local's DATABASE_URL.

# Local PostgreSQL connection string.
# Example: postgresql://freedomtree:freedomtree@localhost:5432/freedomtree_dev
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/freedomtree_dev"
