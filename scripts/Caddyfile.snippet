# ── Freedom Tree — add this block to /etc/caddy/Caddyfile ────────────────────
# Access the app at:  https://toolbox.freedomtree.ca
# Caddy automatically provisions and renews a Let's Encrypt TLS cert for the
# domain — no manual certificate setup needed. Requires the domain's DNS A
# record to point at this server's public IP.
#
# After editing Caddyfile:
#   sudo caddy fmt --overwrite /etc/caddy/Caddyfile
#   sudo systemctl reload caddy

toolbox.freedomtree.ca {
    # Compress responses
    encode gzip

    # Proxy all traffic to Next.js (running on 3001)
    reverse_proxy localhost:3001 {
        # Pass real client IP to Next.js
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # Basic security headers
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}
